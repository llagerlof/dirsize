#!/usr/bin/env bash

# dirsize version 1.0.2

show_hidden=false

# Parse options
while getopts ":h" opt; do
  case $opt in
    h)
      show_hidden=true
      ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

# If the user wants hidden items, enable 'dotglob'
# so that * matches hidden files/directories (except . and ..)
if [ "$show_hidden" = true ]; then
  shopt -s dotglob
fi

# Collect items from the current directory
items=()
for i in *; do
  [ -e "$i" ] || continue     # skip if it doesn't exist (e.g. empty dir)
  items+=("$i")
done

# If we enabled dotglob, disable it again (just to avoid side effects)
if [ "$show_hidden" = true ]; then
  shopt -u dotglob
fi

# List each item with its size, sorted by size in ascending order
for item in "${items[@]}"; do
  size_bytes=$(du -s --block-size=1 "$item" 2>/dev/null | cut -f1)
  size_human=$(du -sh "$item" 2>/dev/null | cut -f1)

  if [[ -z "$size_bytes" || ! "$size_bytes" =~ ^[0-9]+$ ]]; then
    continue
  fi

  if [ -d "$item" ]; then
    printf '%s\t%s - %s/\n' "$size_bytes" "$size_human" "$item"
  else
    printf '%s\t%s - %s\n' "$size_bytes" "$size_human" "$item"
  fi
done | sort -n -k1,1 | cut -f2-

# Print final total of all listed items
total_bytes=$(du -sc --block-size=1 "${items[@]}" 2>/dev/null | tail -n1 | awk '{print $1}')
if [[ -n "$total_bytes" && "$total_bytes" =~ ^[0-9]+$ ]]; then
  total_human=$(numfmt --to=iec-i --suffix=B --format='%9.2f' "$total_bytes")
else
  total_human="0.00B" # Default value if total_bytes is empty or not a number
fi
echo "TOTAL: $total_human"
